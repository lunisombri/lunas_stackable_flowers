{
	"schemaVersion": 1,
	"id": "lunas-stackable-flowers",
	"version": "${version}",
	"name": "Luna´s Stackable Flowers",
	"description": "Bushier, stackable vanilla flowers.",
	"authors": [
		"lunisombri"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/lunas-stackable-flowers/icon.png",
